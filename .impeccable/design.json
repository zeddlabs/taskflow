      "css": ".ds-primary { font-family: var(--font-sans, 'DM Sans Variable', sans-serif); font-size: 15px; line-height: 1.5; font-weight: 650; color: white; background: var(--color-accent, #125942); border: 0; border-radius: 9px; min-height: 44px; padding: 12px 19px; cursor: pointer; } .ds-primary:hover { filter: brightness(1.1); } .ds-primary:disabled { opacity: .7; cursor: wait; } .ds-primary:focus-visible { outline: 3px solid var(--color-focus, #a56512); outline-offset: 4px; }"
    },
    {
      "name": "Welcome link",
      "kind": "button",
      "refersTo": "welcome-link",
      "description": "Open account details from the overview.",
      "html": "<div class=\"ds-welcome\"><a class=\"ds-welcome-link\" href=\"/app/account\">View account <svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></a></div>",
      "css": ".ds-welcome { background: #183f36; padding: 12px; } .ds-welcome-link { font-family: var(--font-sans, 'DM Sans Variable', sans-serif); display: inline-flex; align-items: center; gap: 9px; box-sizing: border-box; min-height: 44px; padding: 9px 13px; background: #e4f1cf; color: #203d2c; border-radius: 9px; font-size: 13px; font-weight: 650; text-decoration: none; } .ds-welcome-link:hover { filter: brightness(1.1); } .ds-welcome-link:focus-visible { outline: 3px solid var(--color-focus-on-dark, #ffe3a8); outline-offset: 4px; }"
    },
    {
      "name": "Email field",
      "kind": "input",
      "refersTo": "text-input",
      "description": "A labeled email input on the public forms.",
      "html": "<div class=\"ds-field\"><label for=\"ds-email\">Email address</label><input type=\"email\" id=\"ds-email\" autocomplete=\"email\"></div>",
      "css": ".ds-field { font-family: var(--font-sans, 'DM Sans Variable', sans-serif); color: var(--color-ink, #182b27); } .ds-field label { display: block; margin-bottom: 7px; font-size: 14px; font-weight: 600; } .ds-field input { box-sizing: border-box; width: 100%; height: 48px; padding: 12px; font: inherit; color: inherit; background: var(--color-panel, #fff); border: 1px solid var(--color-control-border, #7a8a80); border-radius: 9px; } .ds-field input[aria-invalid=\"true\"] { border-color: #c45145; } .ds-field input:focus-visible { outline: 3px solid var(--color-focus, #a56512); outline-offset: 4px; }"
    },
    {
      "name": "Current navigation item",
      "kind": "nav",
      "refersTo": "nav-current",
      "description": "Current page in the desktop rail and mobile drawer.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Main navigation\"><a href=\"/app\" aria-current=\"page\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"7\" height=\"9\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"14\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"9\" x=\"14\" y=\"12\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"/></svg> Overview</a></nav>",
      "css": ".ds-rail { font-family: var(--font-sans, 'DM Sans Variable', sans-serif); background: #142f29; padding: 18px; } .ds-rail a { display: flex; align-items: center; gap: 12px; padding: 11px 14px; font-size: 14px; border-radius: 8px; color: #d1e0d4; text-decoration: none; } .ds-rail a[aria-current=\"page\"] { color: white; background: #2d4d40; font-weight: 650; box-shadow: inset 3px 0 #c6e8a9; } .ds-rail a:hover { background: #28483c; } .ds-rail a:focus-visible { outline: 3px solid var(--color-focus-on-dark, #ffe3a8); outline-offset: 4px; } @media (prefers-color-scheme: dark) { .ds-rail { background: #0e211b; } }"
    },
    {
      "name": "Account detail card",
      "kind": "card",
      "refersTo": "profile-card",
      "description": "Read-only personal account details with the mobile label/value layout.",
      "html": "<section class=\"ds-card\"><h2>Profile details</h2><dl><div><dt>Time zone</dt><dd>UTC</dd></div></dl></section>",
      "css": ".ds-card { font-family: var(--font-sans, 'DM Sans Variable', sans-serif); border: 1px solid var(--color-line, #dbe2db); border-radius: 15px; padding: 24px clamp(20px, 3vw, 32px); background: var(--color-panel, #fff); color: var(--color-ink, #182b27); } .ds-card h2 { margin: 0 0 13px; font-size: 20px; font-weight: 600; letter-spacing: -.6px; } .ds-card dl, .ds-card dd { margin: 0; } .ds-card dl div { display: grid; grid-template-columns: minmax(120px, .65fr) 1fr; gap: 16px; padding: 13px 0; font-size: 14px; } .ds-card dt { color: var(--color-muted, #566761); } .ds-card dd { font-weight: 550; overflow-wrap: anywhere; } @media (max-width: 740px) { .ds-card dl div { grid-template-columns: minmax(94px, .68fr) 1fr; gap: 8px; } } @media (max-width: 420px) { .ds-card dl div { grid-template-columns: 1fr; gap: 3px; } .ds-card dd { padding-left: 27px; } }"
    }
  ],
  "narrative": {
    "northStar": "An editorial workspace with a personal serif greeting.",
    "overview": "The dark green rail orients the user. A personal greeting introduces the overview, and labeled rows make account details easy to scan.",
    "keyCharacteristics": [
      "Green navigation and welcome surfaces",
      "DM Sans for controls and data",
      "Instrument Serif for the personal greeting"
    ],
    "rules": [
      {
        "name": "Welcome typography",
        "body": "Reserve the display face for the greeting.",
