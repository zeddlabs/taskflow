# Set the credentials, port and database from the root .env. Percent-encode credentials.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/taskflow_dev
WEB_ORIGIN=http://localhost:3000
# Generate an independent random secret for each value before starting the API.
JWT_ACCESS_SECRET=
CSRF_SECRET=
JWT_ISSUER=taskflow-api
JWT_AUDIENCE=taskflow-web
