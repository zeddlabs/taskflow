generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model User {
  id              String            @id @default(cuid())
  emailNormalized String            @unique @db.VarChar(320)
  name            String            @db.VarChar(150)
  passwordHash    String            @db.VarChar(255)
  emailVerifiedAt DateTime?
  timezone        String            @default("UTC") @db.VarChar(64)
  avatarUrl       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sessions        AuthSession[]
  memberships     WorkspaceMember[]

  @@map("users")
}

model AuthSession {
  id         String         @id @default(cuid())
  userId     String
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens     RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String      @id @default(cuid())
  sessionId String
  tokenHash String      @unique @db.VarChar(64)
  createdAt DateTime    @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt])
  @@map("refresh_tokens")
}

model Workspace {
  id                        String            @id @default(cuid())
  name                      String            @db.VarChar(150)
  slug                      String            @unique @db.VarChar(80)
  timezone                  String            @default("UTC") @db.VarChar(64)
  allowMemberCreateProjects Boolean           @default(false)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  archivedAt                DateTime?
  members                   WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}
