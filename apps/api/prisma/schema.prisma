generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model User {
  id                String                      @id @default(cuid())
  emailNormalized   String                      @unique @db.VarChar(320)
  name              String                      @db.VarChar(150)
  passwordHash      String                      @db.VarChar(255)
  emailVerifiedAt   DateTime?
  timezone          String                      @default("UTC") @db.VarChar(64)
  avatarUrl         String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  sessions          AuthSession[]
  memberships       WorkspaceMember[]
  auditEvents       AuditLog[]                  @relation("AuditActor")
  emailVerification EmailVerificationChallenge?
  invitationsSent   WorkspaceInvitation[]       @relation("InvitedBy")
  invitationsTaken  WorkspaceInvitation[]       @relation("AcceptedBy")

  @@map("users")
}

model EmailVerificationChallenge {
  userId          String   @id
  emailNormalized String   @db.VarChar(320)
  tokenHash       String   @db.Char(64)
  issuedAt        DateTime @default(now())
  expiresAt       DateTime
  attempts        Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_challenges")
}

model AuthSession {
  id         String         @id @default(cuid())
  userId     String
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens     RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String      @id @default(cuid())
  sessionId String
  tokenHash String      @unique @db.VarChar(64)
  createdAt DateTime    @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt])
  @@map("refresh_tokens")
}

model Workspace {
  id                        String                @id @default(cuid())
  name                      String                @db.VarChar(150)
  slug                      String                @unique @db.VarChar(80)
  timezone                  String                @default("UTC") @db.VarChar(64)
  allowMemberCreateProjects Boolean               @default(false)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  archivedAt                DateTime?
  members                   WorkspaceMember[]
  auditLogs                 AuditLog[]
  invitations               WorkspaceInvitation[]

  @@map("workspaces")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvitation {
  id              String           @id @default(cuid())
  workspaceId     String
  emailNormalized String           @db.VarChar(320)
  role            WorkspaceRole    @default(MEMBER)
  tokenHash       String           @unique @db.VarChar(64)
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedById     String
  acceptedById    String?
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy      User?            @relation("AcceptedBy", fields: [acceptedById], references: [id])

  @@index([workspaceId, status, id])
  @@index([expiresAt, status])
  @@map("workspace_invitations")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String    @db.VarChar(100)
  targetType  String    @db.VarChar(80)
  targetId    String    @db.VarChar(100)
  requestId   String?   @db.VarChar(100)
  details     Json
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, targetType, targetId])
  @@map("audit_logs")
}
