{
  "name": "@taskflow/api",
  "private": true,
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.prisma.json && tsc -p test/tsconfig.json",
    "test": "node --test test/liveness.test.mjs && jest --runInBand",
    "test:db": "pnpm run build && tsx --test test/database.test.ts && jest --runInBand --config jest.db.config.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie": "1.1.1",
    "dotenv": "18.0.10",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.6.1",
    "rate-limiter-flexible": "11.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.1",
    "jest": "30.5.2",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript-eslint": "8.73.0",
    "typescript": "5.9.3"
  }
}
